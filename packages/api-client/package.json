{
  "name": "@mjga/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./mocks": {
      "types": "./src/mocks.ts",
      "default": "./dist/mocks.js"
    }
  },
  "types": "./src/index.ts",
  "main": "./dist/index.js",
  "scripts": {
    "generate": "kubb generate --config kubb.config.ts",
    "generate:check": "node ./scripts/check-generated.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run generate:check && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tanstack/react-query": "5.85.5",
    "zod": "4.1.5"
  },
  "peerDependencies": {
    "@faker-js/faker": "10.6.0",
    "msw": "2.15.0"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": { "optional": true },
    "msw": { "optional": true }
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@kubb/adapter-oas": "5.1.0",
    "@kubb/plugin-faker": "5.0.3",
    "@kubb/plugin-fetch": "5.2.1",
    "@kubb/plugin-msw": "5.0.1",
    "@kubb/plugin-react-query": "5.0.3",
    "@kubb/plugin-ts": "5.0.1",
    "@kubb/plugin-zod": "5.1.3",
    "kubb": "5.1.0",
    "msw": "2.15.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "4.1.6"
  }
}
