{
  "name": "@mjga/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:production-bundle": "node ./scripts/check-production-bundle.mjs",
    "mutation": "stryker run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:browser && npm run build && npm run test:production-bundle"
  },
  "dependencies": {
    "@mjga/api-client": "1.0.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.85.5",
    "@tanstack/react-router": "1.170.32",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@fast-check/vitest": "0.4.1",
    "@stryker-mutator/core": "9.0.1",
    "@stryker-mutator/vitest-runner": "9.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "@vitest/browser-playwright": "4.1.6",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "msw": "2.15.0",
    "playwright": "1.55.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vite": "7.1.3",
    "vitest": "4.1.6",
    "vitest-browser-react": "2.2.0"
  }
}
